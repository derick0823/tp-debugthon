[
 {
  "seg": 0,
  "n": 1,
  "text": "臺北每 10 棟房子，有 9 棟超過 30 年。",
  "file": "0-1.mp3",
  "seconds": 4.392
 },
 {
  "seg": 0,
  "n": 2,
  "text": "地震來了，先救誰？",
  "file": "0-2.mp3",
  "seconds": 2.832
 },
 {
  "seg": 0,
  "n": 3,
  "text": "住戶怎麼辦？",
  "file": "0-3.mp3",
  "seconds": 2.064
 },
 {
  "seg": 1,
  "n": 1,
  "text": "我們把高齡、老屋、液化、窄巷、軟弱層五件事放在一起，排出 456 個里誰先健檢。",
  "file": "1-1.mp3",
  "seconds": 9.264
 },
 {
  "seg": 1,
  "n": 2,
  "text": "權重怎麼調，排名怎麼動，都看得到。",
  "file": "1-2.mp3",
  "seconds": 4.368
 },
 {
  "seg": 2,
  "n": 1,
  "text": "這個里每 100 人有 8 位超過 80 歲，9 條窄巷消防車進不去。",
  "file": "2-1.mp3",
  "seconds": 6.096
 },
 {
  "seg": 2,
  "n": 2,
  "text": "里長拿著這張表，就知道先演練什麼。",
  "file": "2-2.mp3",
  "seconds": 4.248
 },
 {
  "seg": 3,
  "n": 1,
  "text": "輸入你家地址，看現在值多少、分回多少。",
  "file": "3-1.mp3",
  "seconds": 4.944
 },
 {
  "seg": 3,
  "n": 2,
  "text": "同一戶，用新成屋算是賺 539 萬，用真實都更案算是虧 429 萬。",
  "file": "3-2.mp3",
  "seconds": 7.8
 },
 {
  "seg": 3,
  "n": 3,
  "text": "划不划算，看你信哪個單價。",
  "file": "3-3.mp3",
  "seconds": 3.528
 },
 {
  "seg": 4,
  "n": 1,
  "text": "多出來的容積是一塊一塊疊上去的。",
  "file": "4-1.mp3",
  "seconds": 3.888
 },
 {
  "seg": 4,
  "n": 2,
  "text": "點一塊，告訴你為什麼、法源在哪。",
  "file": "4-2.mp3",
  "seconds": 4.176
 },
 {
  "seg": 4,
  "n": 3,
  "text": "全臺北最常拿的是好設計和留人行道。",
  "file": "4-3.mp3",
  "seconds": 4.272
 },
 {
  "seg": 5,
  "n": 1,
  "text": "同意書收到哪，大家看同一張板子。",
  "file": "5-1.mp3",
  "seconds": 4.056
 },
 {
  "seg": 5,
  "n": 2,
  "text": "差幾戶、誰要補掛號信、什麼時候可以撤銷，一目了然。",
  "file": "5-2.mp3",
  "seconds": 6.264
 },
 {
  "seg": 6,
  "n": 1,
  "text": "100 棟老公寓，照現在的做法只有 13 棟過得了全體同意。",
  "file": "6-1.mp3",
  "seconds": 5.712
 },
 {
  "seg": 6,
  "n": 2,
  "text": "講清楚分回、派個案經理，可以到 45 棟。",
  "file": "6-2.mp3",
  "seconds": 4.92
 },
 {
  "seg": 7,
  "n": 1,
  "text": "都更要過 8 站、跨 4 個局處，光是送件到核定，中位數就要 2.7 年。",
  "file": "7-1.mp3",
  "seconds": 7.272
 },
 {
  "seg": 7,
  "n": 2,
  "text": "我們把它畫成一張捷運圖，每一站誰負責、要多久。",
  "file": "7-2.mp3",
  "seconds": 5.448
 },
 {
  "seg": 8,
  "n": 1,
  "text": "都更後，屋頂可以不是鐵皮。",
  "file": "8-1.mp3",
  "seconds": 3.456
 },
 {
  "seg": 8,
  "n": 2,
  "text": "拖一下，選你喜歡的樣子，按個讚，設計從住戶開始。",
  "file": "8-2.mp3",
  "seconds": 6.12
 },
 {
  "seg": 9,
  "n": 1,
  "text": "六個工具，一份公開資料。",
  "file": "9-1.mp3",
  "seconds": 3.36
 },
 {
  "seg": 9,
  "n": 2,
  "text": "你是住戶、里長還是市府，選一個，我們幫你排路線。",
  "file": "9-2.mp3",
  "seconds": 6.072
 }
]